{
  "cli_default_open_behavior": "new_window",
  "session": {
    "trust_all_worktrees": true
  },
  "base_keymap": "VSCode",
  "minimap": {
    "show": "never"
  },
  "autosave": "on_focus_change",
  "show_whitespaces": "trailing",
  "wrap_guides": [
    120
  ],
  "preferred_line_length": 120,
  "agent_servers": {
    "claude-acp": {
      "type": "registry"
    }
  },
  "buffer_font_family": "JetBrainsMono Nerd Font",
  "vim_mode": true,
  "project_panel": {
    "default_width": 240,
    "dock": "right",
    "entry_spacing": "comfortable",
    "file_icons": true,
    "folder_icons": true,
    "git_status": true,
    "auto_reveal_entries": true,
    "auto_fold_dirs": true
  },
  "ui_font_size": 14,
  "buffer_font_size": 18,
  "buffer_font_features": {
    "calt": false
  },
  "terminal": {
    "font_size": 16,
  },
  "languages": {
    "C": {
      "format_on_save": "on"
    }
  },
  "theme": {
    "mode": "system",
    "light": "GitHub Light",
    "dark": "GitHub Dark"
  },
  "auto_install_extensions": {
    "csv": true,
    "docker-compose": true,
    "dockerfile": true,
    "elixir": true,
    "git-firefly": true,
    "github-theme": true,
    "graphql": true,
    "haskell": true,
    "html": true,
    "java": true,
    "latex": true,
    "lua": true,
    "make": true,
    "nix": true,
    "ruby": true,
    "sql": true,
    "terraform": true,
    "toml": true,
    "typst": true,
    "zig": true
  }
}
