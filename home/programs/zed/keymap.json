// Zed keymap
//
// For information on binding keys, see the Zed
// documentation: https://zed.dev/docs/key-bindings
//
// To see the default key bindings run `zed: open default keymap`
// from the command palette.
[
  {
    "context": "Workspace",
    "bindings": {
      // "shift shift": "file_finder::Toggle"
      // Same as ghostty's alt+hjkl goto_split.
      "alt-h": "workspace::ActivatePaneLeft",
      "alt-j": "workspace::ActivatePaneDown",
      "alt-k": "workspace::ActivatePaneUp",
      "alt-l": "workspace::ActivatePaneRight",
      "ctrl-j": "terminal_panel::Toggle",
      "alt-shift-b": "project_panel::Toggle"
    }
  },
  {
    // macOS only: same as ghostty's and cmux's cmd+hjkl. `!(os == linux)` matches
    // at the focused element, so these win over defaults on the same keys
    // (zed::Hide, editor::SelectLine, terminal::Clear, cmd-k chords), while
    // `os == macos` only matches at the Workspace and loses to them.
    "context": "!(os == linux)",
    "bindings": {
      "cmd-h": "workspace::ActivatePaneLeft",
      "cmd-j": "workspace::ActivatePaneDown",
      "cmd-k": "workspace::ActivatePaneUp",
      "cmd-l": "workspace::ActivatePaneRight",
      // Find and replace (pane::DeploySearch, search::ToggleReplace).
      "cmd-shift-h": null
    }
  },
  {
    // Vim mode binds ctrl-j to vim::Down, which wins over Workspace bindings.
    "context": "VimControl && !menu",
    "bindings": {
      "ctrl-j": "terminal_panel::Toggle"
    }
  },
  {
    // Same as VS Code's <leader>t mix tasks (see tasks.json).
    "context": "VimControl && !menu",
    "bindings": {
      "space t a": ["task::Spawn", { "task_name": "mix: Run tests" }],
      "space t f": ["task::Spawn", { "task_name": "mix: Run tests in current file" }],
      "space t r": ["task::Spawn", { "task_name": "mix: Run test at cursor" }],
      "space t l": "task::Rerun"
    }
  },
  {
    // projectionist tasks (see tasks.json). alt-a is the same as VS Code's
    // alt+a; alt-shift-a takes over Zed's editor::ToggleBlockComments.
    "context": "Editor && mode == full",
    "bindings": {
      "alt-a": ["task::Spawn", { "task_name": "projectionist: Open alternate file" }],
      "alt-shift-a": ["task::Spawn", { "task_name": "projectionist: Open next related file" }]
    }
  },
  {
    // Same as VS Code's and toggleterm's ctrl-c ctrl-c: run the current line,
    // or the selection, in the terminal and come back to the editor. Zed has no
    // action for this, so it goes through the clipboard: yank, focus the
    // terminal (ctrl-j), paste, enter, then back up to the editor (alt-k).
    "context": "vim_mode == normal && !menu",
    "bindings": {
      "ctrl-c ctrl-c": ["workspace::SendKeystrokes", "y y ctrl-j ctrl-shift-v enter alt-k"]
    }
  },
  {
    "context": "vim_mode == visual && !menu",
    "bindings": {
      "ctrl-c ctrl-c": ["workspace::SendKeystrokes", "y ctrl-j ctrl-shift-v enter alt-k"]
    }
  },
  {
    // Already the default on Linux; makes the ctrl-c ctrl-c keystrokes above
    // paste on macOS too.
    "context": "Terminal",
    "bindings": {
      "ctrl-shift-v": "terminal::Paste"
    }
  },
  {
    "context": "ProjectPanel && not_editing",
    "bindings": {
      "a": "project_panel::NewFile",
      "d": ["project_panel::Trash", { "skip_prompt": false }]
    }
  },
  {
    "context": "Editor",
    "bindings": {
      // "j k": ["workspace::SendKeystrokes", "escape"]
    }
  },
  {
    "context": "Pane",
    "bindings": {
      // Same as ghostty's alt+shift+v / alt+shift+h splits.
      "alt-shift-v": "pane::SplitVertical",
      "alt-shift-h": "pane::SplitHorizontal"
    }
  }
]
