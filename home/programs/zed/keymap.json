// Zed keymap
//
// For information on binding keys, see the Zed
// documentation: https://zed.dev/docs/key-bindings
//
// To see the default key bindings run `zed: open default keymap`
// from the command palette.
[
  {
    // LINUX
    "context": "Workspace && os == linux",
    "bindings": {
      "alt-h": "workspace::ActivatePaneLeft",
      "alt-j": "workspace::ActivatePaneDown",
      "alt-k": "workspace::ActivatePaneUp",
      "alt-l": "workspace::ActivatePaneRight",
      "ctrl-j": "terminal_panel::Toggle",
      "alt-shift-b": "project_panel::Toggle"
    }
  },
  {
    // `!(os == linux)` matches at the focused element, so these win over the
    // defaults on the same keys (zed::Hide, editor::SelectLine,
    // terminal::Clear, cmd-k chords), the same as ghostty's cmd+hjkl.
    "context": "!(os == linux)",
    "bindings": {
      "cmd-h": "workspace::ActivatePaneLeft",
      "cmd-j": "workspace::ActivatePaneDown",
      "cmd-k": "workspace::ActivatePaneUp",
      "cmd-l": "workspace::ActivatePaneRight"
    }
  },
  {
    "context": "Workspace && !(os == linux)",
    "bindings": {
      "ctrl-j": "terminal_panel::Toggle",
      "cmd-shift-b": "project_panel::Toggle",
      "cmd-shift-h": null
    }
  },
  {
    // Vim mode binds ctrl-j to vim::Down, which wins over Workspace bindings.
    "context": "VimControl && !menu",
    "bindings": {
      "ctrl-j": "terminal_panel::Toggle"
    }
  },
  {
    // Same as VS Code's <leader>t mix tasks (see tasks.json).
    "context": "VimControl && !menu",
    "bindings": {
      "space t a": ["task::Spawn", { "task_name": "mix: Run tests" }],
      "space t f": ["task::Spawn", { "task_name": "mix: Run tests in current file" }],
      "space t r": ["task::Spawn", { "task_name": "mix: Run test at cursor" }],
      "space t l": "task::Rerun"
    }
  },
  {
    // projectionist tasks (see tasks.json). alt-a is the same as VS Code's
    // alt+a; alt-shift-a takes over Zed's editor::ToggleBlockComments.
    "context": "Editor && mode == full",
    "bindings": {
      "alt-a": ["task::Spawn", { "task_name": "projectionist: Open alternate file" }],
      "alt-shift-a": ["task::Spawn", { "task_name": "projectionist: Open next related file" }]
    }
  },
  {
    // Same as VS Code's and toggleterm's ctrl-c ctrl-c: run the line, or the
    // selection, in the terminal and go back to the editor. It goes through
    // the clipboard: yank, focus the terminal (ctrl-j), paste, enter, then
    // back (ctrl-shift-j).
    "context": "vim_mode == normal && !menu",
    "bindings": {
      "ctrl-c ctrl-c": ["workspace::SendKeystrokes", "y y ctrl-j ctrl-shift-v enter ctrl-shift-j"]
    }
  },
  {
    "context": "vim_mode == visual && !menu",
    "bindings": {
      "ctrl-c ctrl-c": ["workspace::SendKeystrokes", "y ctrl-j ctrl-shift-v enter ctrl-shift-j"]
    }
  },
  {
    "context": "Terminal",
    "bindings": {
      "ctrl-shift-v": "terminal::Paste",
      // Back to the editor pane it came from, and the terminal stays open
      // (ctrl-j would close it).
      "ctrl-shift-j": "terminal_panel::ToggleFocus"
    }
  },
  {
    "context": "ProjectPanel && not_editing",
    "bindings": {
      "a": "project_panel::NewFile",
      "d": ["project_panel::Trash", { "skip_prompt": false }]
    }
  },
  {
    "context": "Editor",
    "bindings": {
      // "j k": ["workspace::SendKeystrokes", "escape"]
    }
  },
  {
    "context": "Pane && os == linux",
    "bindings": {
      "alt-shift-v": "pane::SplitVertical",
      "alt-shift-h": "pane::SplitHorizontal"
    }
  },
  {
    "context": "Pane && !(os == linux)",
    "bindings": {
      "cmd-shift-v": "pane::SplitVertical",
      "cmd-shift-h": "pane::SplitHorizontal"
    }
  }
]
