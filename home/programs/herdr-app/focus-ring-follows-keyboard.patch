+    /// Whether the keyboard is held by something other than the focused pane's
+    /// terminal: a side panel mod, a float, a dialog. The window's own handle
+    /// doesn't count, as it only holds the keyboard until a pane takes it.
+    fn keyboard_elsewhere(&self, window: &Window, cx: &App) -> bool {
+        window.focused(cx).is_some()
+            && !self.focus.is_focused(window)
+            && self.focused_pane.as_deref().and_then(|p| self.pane_focus(p)).is_some_and(|f| !f.contains_focused(window, cx))
+    }
