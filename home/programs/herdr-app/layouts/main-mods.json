{
  "id": "root",
  "cloned_from": {
    "name": "main",
    "version": "0.1.9"
  },
  "type": "row",
  "children": [
    {
      "id": "sidebar",
      "type": "column",
      "children": [
        {
          "id": "brand",
          "type": "block",
          "content": {
            "mod": "workspace-chrome"
          },
          "size": {
            "px": 46
          },
          "window_drag": true
        },
        {
          "id": "sidebar-lists",
          "type": "column",
          "children": [
            {
              "id": "spaces",
              "type": "block",
              "content": {
                "mod": "profile-pictures"
              },
              "size": {
                "weight": 1
              },
              "min": 90
            },
            {
              "id": "agents",
              "type": "block",
              "content": {
                "mod": "agents"
              },
              "size": {
                "weight": 1
              },
              "min": 90
            }
          ]
        },
        {
          "id": "sidebar-footer",
          "type": "block",
          "content": {
            "mod": "workspace-chrome",
            "props": {
              "footer": true
            }
          },
          "size": {
            "px": 69
          }
        }
      ],
      "size": {
        "px": 268
      },
      "min": 44,
      "max": 480,
      "background": "chrome",
      "resizable": false
    },
    {
      "id": "work",
      "type": "column",
      "children": [
        {
          "id": "tabs",
          "type": "block",
          "content": {
            "mod": "better-tabs",
            "props": {
              "rememberPanels": {
                "container": "panel",
                "stack": "panel-body"
              },
              "buttons": [
                {
                  "id": "files",
                  "label": "Files",
                  "icon": "file",
                  "group": "panels",
                  "action": {
                    "type": "panel",
                    "container": "panel",
                    "stack": "panel-body",
                    "target": "files"
                  }
                },
                {
                  "id": "changes",
                  "label": "Changes",
                  "icon": "changes",
                  "group": "panels",
                  "action": {
                    "type": "panel",
                    "container": "panel",
                    "stack": "panel-body",
                    "target": "changes"
                  }
                },
                {
                  "id": "graph",
                  "label": "Graph",
                  "icon": "mods/git-graph/icons/graph.svg",
                  "group": "panels",
                  "action": {
                    "type": "panel",
                    "container": "panel",
                    "stack": "panel-body",
                    "target": "graph"
                  }
                },
                {
                  "id": "notes",
                  "label": "Notes",
                  "icon": "mods/tab-notes/notes.svg",
                  "group": "panels",
                  "action": {
                    "type": "panel",
                    "container": "panel",
                    "stack": "panel-body",
                    "target": "notes"
                  }
                }
              ],
              "commands": {
                "files": {
                  "type": "hook",
                  "name": "showPanel",
                  "args": {
                    "panel": "files",
                    "focus": "filetree.focus"
                  }
                },
                "changes": {
                  "type": "hook",
                  "name": "showPanel",
                  "args": {
                    "panel": "changes"
                  }
                },
                "graph": {
                  "type": "hook",
                  "name": "showPanel",
                  "args": {
                    "panel": "graph"
                  }
                },
                "notes": {
                  "type": "hook",
                  "name": "showPanel",
                  "args": {
                    "panel": "notes",
                    "focus": "tab-notes.focus"
                  }
                }
              }
            }
          },
          "size": {
            "px": 42
          },
          "window_drag": true
        },
        {
          "id": "work-body",
          "type": "row",
          "children": [
            {
              "id": "main",
              "type": "block",
              "content": {
                "tab": "active",
                "pane": {
                  "header": {
                    "content": {
                      "mod": "pane"
                    },
                    "reveal": "always",
                    "height": 30,
                    "position": "top"
                  },
                  "background": "background",
                  "border": {
                    "width": 1,
                    "color": "border"
                  },
                  "focus": {
                    "width": 1,
                    "color": "accent"
                  },
                  "radius": 10,
                  "gap": 8,
                  "lone": true
                }
              }
            },
            {
              "id": "panel",
              "type": "column",
              "children": [
                {
                  "id": "panel-body",
                  "type": "stack",
                  "children": [
                    {
                      "id": "files",
                      "type": "block",
                      "content": {
                        "mod": "filetree"
                      }
                    },
                    {
                      "id": "changes",
                      "type": "block",
                      "content": {
                        "mod": "tabbed-changes"
                      }
                    },
                    {
                      "id": "graph",
                      "type": "block",
                      "content": {
                        "mod": "git-graph"
                      }
                    },
                    {
                      "id": "notes",
                      "type": "block",
                      "content": {
                        "mod": "tab-notes"
                      }
                    }
                  ],
                  "active": "files"
                }
              ],
              "size": {
                "px": 368
              },
              "min": 280,
              "max": 900,
              "hidden": true
            }
          ],
          "padding": 8,
          "gap": 8
        },
        {
          "id": "status",
          "type": "block",
          "content": {
            "mod": "workspace-status"
          },
          "size": {
            "px": 28
          }
        }
      ],
      "resizable": false
    }
  ],
  "background": "canvas",
  "terminal_padding": [
    14,
    12
  ],
  "divider": {
    "width": 1,
    "color": "border"
  },
  "titlebar": "none",
  "traffic_lights": [
    12,
    16
  ]
}
