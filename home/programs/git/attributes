# A hunk header names the function, heading or rule the change is in. git's
# own guess is made for C, so each language gets the driver git ships for it.
*.ex        diff=elixir
*.exs       diff=elixir
*.md        diff=markdown
*.markdown  diff=markdown
*.py        diff=python
*.rs        diff=rust
*.go        diff=golang
*.rb        diff=ruby
*.sh        diff=bash
*.bash      diff=bash
*.zsh       diff=bash
*.css       diff=css
*.scss      diff=css
*.html      diff=html
*.tex       diff=tex

*.pdf   diff=pdf

*.docx  diff=document
*.odt   diff=document
*.rtf   diff=document
*.epub  diff=document
*.doc   diff=doc

*.xlsx  diff=xlsx
*.xlsm  diff=xlsx
*.xls   diff=xls

*.png  diff=image
*.jpg  diff=image
*.jpeg diff=image
*.gif  diff=image
*.webp diff=image
*.tiff diff=image
*.bmp  diff=image
*.jxl  diff=image
*.avif diff=image
*.heic diff=image

bun.lock merge=binary
mix.lock merge=binary
package-lock.json merge=binary
yarn.lock merge=binary
Cargo.lock merge=binary
poetry.lock merge=binary
flake.lock merge=binary
