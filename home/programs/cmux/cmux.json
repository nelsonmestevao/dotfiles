{
  "$schema": "https://raw.githubusercontent.com/manaflow-ai/cmux/main/web/data/cmux.schema.json",
  "schemaVersion": 1,

  "app": {
    "accentColor": "system"
  },

  "shortcuts": {
    "bindings": {
      "selectSurfaceByNumber": "cmd+1",
      "selectWorkspaceByNumber": "ctrl+1",

      "focusLeft": "cmd+h",
      "focusDown": "cmd+j",
      "focusUp": "cmd+k",
      "focusRight": "cmd+l",

      "splitRight": "cmd+opt+v",
      "splitDown": "cmd+opt+h",

      "toggleSidebar": "cmd+b",
      "toggleFileExplorer": "cmd+shift+b",

      "triggerFlash": "cmd+opt+ctrl+h"
    }
  },

  "fileEditor": {
    "syntaxHighlighting": true
  }
}
