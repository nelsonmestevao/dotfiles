#
# The interactive shell, top to bottom. Home Manager writes its own part
# around this file: history, aliases, and what other programs add.

export DOTFILES="${DOTFILES:-$HOME/.dotfiles}"
export SPELLS="$HOME/.spells"

# Powerlevel10k's instant prompt draws the prompt at once, while the rest
# loads. It must stay near the top: anything that asks for input (a password,
# a yes or no) goes above it.
if [[ -r "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh" ]]; then
  source "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh"
fi

# Spells are optional (https://github.com/nelsonmestevao/spells).
if [[ -r "$SPELLS/spells.init" ]]; then
  source "$SPELLS/spells.init"
fi

# The zsh files next to this one, in name order: plugins.zsh before theme.zsh,
# which starts oh-my-zsh. The quotes keep a checkout path with a space in one
# piece, and (N) lets the loop do nothing if none is found, where a bare glob
# would stop zsh from reading the rest of this file.
for module in "$DOTFILES"/home/programs/zsh/*.zsh(N); do
  source "$module"
done

# Start in the working directory set with `chwd`, if there is one. gtwd comes
# from functions.zsh, which the loop above skips when the checkout is missing.
(( $+functions[gtwd] )) && gtwd

# Up and Down search the history for lines that start like the one typed.
if [[ -n "${terminfo[kcuu1]}" ]]; then
  autoload -U up-line-or-beginning-search
  zle -N up-line-or-beginning-search
  bindkey "${terminfo[kcuu1]}" up-line-or-beginning-search
fi
if [[ -n "${terminfo[kcud1]}" ]]; then
  autoload -U down-line-or-beginning-search
  zle -N down-line-or-beginning-search
  bindkey "${terminfo[kcud1]}" down-line-or-beginning-search
fi
