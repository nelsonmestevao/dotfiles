theme = dark:"Night",light:"Day"
font-family = "JetBrains Mono Nerd Font"
font-size = 16

shell-integration = zsh
# ssh runs through `ghostty +ssh`: it forwards COLORTERM and sends
# TERM=xterm-256color. No ssh-terminfo: with xterm-ghostty, servers whose
# .bashrc only colors *-256color terminals lose the prompt colors.
shell-integration-features = ssh-env

window-theme = system
window-decoration = true
window-colorspace = display-p3

macos-icon = xray
macos-titlebar-style = tabs
macos-titlebar-proxy-icon = hidden
macos-non-native-fullscreen = true

gtk-titlebar = false
#gtk-adwaita = true
gtk-wide-tabs = true
gtk-tabs-location = bottom
adw-toolbar-style = flat

cursor-style = block
cursor-color = #ffffff

background-opacity = 0.6
background-blur = 100

config-file = ?keybindings
