#!/usr/bin/env -S nix --extra-experimental-features nix-command --extra-experimental-features flakes develop --command xonsh --no-rc
"""
Updates the flake inputs.

Usage:
  {program} [--save]
  {program} (-h | --help)
  {program} (-v | --version)

Options:
  -h --help         Show this screen.
  -v --version      Show version.
  --save            Commit the lockfile changes describing the updated inputs.
"""
from datetime import datetime, timezone
import json
import os
import subprocess
import sys

sys.path.insert(0, os.path.join(os.path.dirname(os.path.dirname(os.path.abspath(__file__))), "scripts"))
from common import GREEN, RED, YELLOW, fail, interrupted, need, paint, run

# The summary's other colours, next to common's red, green and yellow.
BLUE, CYAN, GREY = 34, 36, 90

# The kinds of change, in the order the summary counts them.
KINDS = ('updated', 'added', 'removed')


# ── Reading flake.lock ─────

def read_inputs(path='flake.lock'):
    """Every input in the lock file, keyed by its path from the flake, like
    ('vicinae',) or ('vicinae', 'numen'). An input with a pin of its own maps
    to its `locked` attributes. One that follows another maps to that input's
    path, as text. The walk is the one nix makes when it prints what an update
    changed."""
    if not os.path.exists(path):
        return {}
    with open(path) as file:
        lock = json.load(file)
    nodes, inputs, seen = lock['nodes'], {}, set()

    def walk(node, prefix):
        # Like nix, walk a node two inputs share only once. It also ends a loop.
        if node in seen:
            return
        seen.add(node)
        for name, target in sorted(nodes[node].get('inputs', {}).items()):
            # A list is the path of the input this one follows.
            if isinstance(target, list):
                inputs[(*prefix, name)] = '/'.join(target)
            else:
                inputs[(*prefix, name)] = nodes[target]['locked']
                walk(target, (*prefix, name))

    walk(lock['root'], ())
    return inputs


def forge(locked):
    """The repo's web page, and a compare link with {old} and {new} to fill,
    for an input on GitHub, GitLab or sourcehut. sourcehut has no compare
    page. An input anywhere else has neither."""
    owner, repo, host = locked.get('owner'), locked.get('repo'), locked.get('host')
    match locked['type']:
        case 'github':
            page = f'https://{host or "github.com"}/{owner}/{repo}'
            return page, page + '/compare/{old}...{new}'
        case 'gitlab':
            page = f'https://{host or "gitlab.com"}/{owner}/{repo}'
            return page, page + '/-/compare/{old}...{new}'
        case 'sourcehut':
            return f'https://{host or "git.sr.ht"}/{owner}/{repo}', None
    return None, None


def flake_ref(locked):
    """The locked input as a flake reference, close to how nix writes it."""
    kind = locked['type']
    if kind in ('github', 'gitlab', 'sourcehut'):
        return f"{kind}:{locked['owner']}/{locked['repo']}/{locked['rev']}"
    if kind == 'path':
        return f"path:{locked['path']}"
    url = f"{kind}+{locked['url']}" if kind in ('git', 'hg') else locked.get('url', kind)
    query = '&'.join(f'{key}={locked[key]}' for key in ('ref', 'rev') if key in locked)
    return f'{url}?{query}' if query else url


def pin(locked):
    """What the summary and the commit show of one locked input."""
    if isinstance(locked, str):
        # It follows another input, so it has no pin of its own to show.
        return {'rev': None, 'ref': f"follows '{locked}'", 'date': None, 'page': None, 'compare': None}
    page, compare = forge(locked)
    stamp = locked.get('lastModified')
    return {
        'rev': locked.get('rev'),
        'ref': flake_ref(locked),
        # Nix gives the day in UTC.
        'date': datetime.fromtimestamp(stamp, timezone.utc).strftime('%Y-%m-%d') if stamp else None,
        'page': page,
        'compare': compare,
    }


def changes(before, after):
    """The inputs that differ between two reads of flake.lock, in the order
    nix lists them. A path sorts as a list of names, so vicinae/numen comes
    right after vicinae."""
    found = []
    for path in sorted(before.keys() | after.keys()):
        old, new = before.get(path), after.get(path)
        if old == new:
            continue
        # An input that only follows another pins nothing, so there's nothing
        # to say when it comes or goes. It shows when it gains or drops a pin
        # of its own.
        if (old is None and isinstance(new, str)) or (new is None and isinstance(old, str)):
            continue
        old = None if old is None else pin(old)
        new = None if new is None else pin(new)
        compare = None
        if old and new and old['rev'] and new['compare']:
            compare = new['compare'].format(old=old['rev'], new=new['rev'])
        found.append({
            'name': '/'.join(path),
            'kind': 'added' if old is None else 'removed' if new is None else 'updated',
            'old': old,
            'new': new,
            'page': (new or old)['page'],
            'compare': compare,
        })
    return found


def shown(change, side):
    """One side of a change: its short commit when the input is on a forge,
    or else its whole flake reference."""
    pinned = change[side]
    return pinned['rev'][:7] if change['page'] and pinned['rev'] else pinned['ref']


def update():
    """Runs `nix flake update`, and returns what flake.lock pinned before and
    after it."""
    before = read_inputs()
    try:
        gum spin --spinner=dot --title 'Updating flake inputs...' --show-error -- nix flake update
    except subprocess.CalledProcessError as problem:
        fail('Interrupted.' if interrupted(problem) else 'nix flake update failed.')
    return before, read_inputs()


# ── The commit ─────

def format_title(changes):
    names = [c['name'] for c in changes]
    suffix = 'input' if len(names) == 1 else 'inputs'
    if len(names) == 1:
        listing = names[0]
    elif len(names) == 2:
        listing = f'{names[0]} and {names[1]}'
    else:
        listing = f"{', '.join(names[:-1])} and {names[-1]}"
    return f'chore: upgrade {listing} {suffix}'


def in_code(change, side):
    date = change[side]['date']
    text = f'`{shown(change, side)}`'
    return f'{text} ({date})' if date else text


def format_section(change):
    lines = [f"### {change['name']}", '']
    if change['page']:
        lines.append(f"- **Source:** {change['page']}")
    match change['kind']:
        case 'updated' if change['page']:
            lines.append(f"- **Update:** {in_code(change, 'old')} → {in_code(change, 'new')}")
        case 'updated':
            lines.append(f"- {in_code(change, 'old')}")
            lines.append(f"- → {in_code(change, 'new')}")
        case 'added':
            lines.append(f"- **Added:** {in_code(change, 'new')}")
        case 'removed':
            lines.append(f"- **Removed:** {in_code(change, 'old')}")
    if change['compare']:
        lines.append(f"- **Compare:** {change['compare']}")
    return '\n'.join(lines)


def format_body(changes):
    return '\n\n'.join(format_section(c) for c in changes) + '\n'


def save_commit(changes):
    if not changes:
        print(paint('✗ No inputs were updated; nothing to commit.', YELLOW))
        return

    title = format_title(changes)
    git add flake.lock
    git commit -m @(title) -m @(format_body(changes))
    print(f"{paint('✓ Committed:', GREEN)} {title}")


# ── The summary ─────

def headline(changes):
    """Like "3 inputs updated", or "3 inputs changed: 2 updated, 1 added"
    when there is more than one kind of change."""
    counts = {kind: sum(c['kind'] == kind for c in changes) for kind in KINDS}
    kinds = [kind for kind in KINDS if counts[kind]]
    word = 'input' if len(changes) == 1 else 'inputs'
    if len(kinds) == 1:
        return f'{len(changes)} {word} {kinds[0]}'
    return f"{len(changes)} {word} changed: {', '.join(f'{counts[k]} {k}' for k in kinds)}"


def dated(change, side, color=None):
    date = change[side]['date']
    text = shown(change, side)
    text = paint(text, color) if color else text
    return f"{text} {paint('(' + date + ')', GREY)}" if date else text


def print_change(change):
    print(f"  {paint(change['name'], CYAN)}")
    match change['kind']:
        case 'updated' if change['page']:
            print(f"    {dated(change, 'old', RED)} {paint('→', GREEN)} {dated(change, 'new', GREEN)}")
        case 'updated':
            print(f"    {dated(change, 'old')}")
            print(f"    {paint('→', GREEN)} {dated(change, 'new')}")
        case 'added':
            print(f"    {paint('added', GREEN)} {dated(change, 'new', GREEN)}")
        case 'removed':
            print(f"    {paint('removed', RED)} {dated(change, 'old', RED)}")
    # An update links to its commits. A new or removed input has nothing to
    # compare, so it links to its repo.
    if change['compare']:
        print(f"    {paint(change['compare'], BLUE)}")
    elif change['kind'] != 'updated' and change['page']:
        print(f"    {paint(change['page'], BLUE)}")
    print()


def print_summary(changes):
    if not changes:
        print(paint('• No inputs changed.', YELLOW))
        return

    print(f"\n{paint('✓', GREEN)} {headline(changes)}\n")
    for change in changes:
        print_change(change)


def main(args):
    need('gum', 'nix')
    found = changes(*update())
    print_summary(found)
    match args:
        case {'--save': True}:
            save_commit(found)


if __name__ == '__main__':
    run(main, __doc__, __file__)

