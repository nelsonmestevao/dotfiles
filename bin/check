#!/usr/bin/env -S nix --extra-experimental-features "nix-command flakes" develop --command xonsh
"""
Checks that the flake evaluates and every configuration builds.

Usage:
  {program} [--eval]
  {program} (-h | --help)
  {program} (-v | --version)

Options:
  -h --help         Show this screen.
  -v --version      Show version.
  --eval            Only evaluate every configuration, the Mac ones too, and
                    build nothing. This catches option and assertion errors in
                    about a minute.
"""
import os

from docopt import docopt

os.chdir(os.path.dirname(os.path.dirname(os.path.abspath(__file__))))

def check_all_systems(build=True):
  if build:
    nix flake check --all-systems
  else:
    nix flake check --all-systems --no-build

def main(args):
    check_all_systems(build=not args['--eval'])

if __name__ == '__main__':
    arguments = docopt(__doc__.format(program=__file__), version=f'{os.path.basename(__file__)} script version 1.0')
    main(arguments)

# vim: ft=xonsh
