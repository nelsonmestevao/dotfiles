#!/usr/bin/env -S nix --extra-experimental-features nix-command --extra-experimental-features flakes develop --command xonsh --no-rc
"""
Checks the flake: evaluates every configuration, builds this machine's checks,
or proves that a change still builds the same derivations.

Usage:
  {program} [--eval | --all-systems]
  {program} --same [<rev>] [--why]
  {program} --list
  {program} (-h | --help)
  {program} (-v | --version)

Arguments:
  <rev>             The commit to compare the working tree with. Defaults to
                    HEAD, which shows what your uncommitted work changes.

Options:
  -h --help         Show this screen.
  -v --version      Show version.
  --eval            Only evaluate every configuration, the Mac ones too, and
                    build nothing. This catches option and assertion errors in
                    about a minute.
  --all-systems     Build the checks of every system, not only this machine's.
                    This needs a builder for the other OS: a Linux builder on
                    a Mac, a Mac builder on Linux.
  --same            Compare the derivation of every configuration at <rev>
                    with the working tree. Exits 0 only when all are the same,
                    so it proves a refactor changed nothing.
  --why             With --same, show what differs in each changed derivation.
  --list            Print the derivation of every check in the working tree,
                    by system and name, as JSON. This is the list --same
                    compares, and CI keys its builds on it.

With no option it evaluates every configuration on every system, then builds
the checks of this machine's system only, like each CI runner does.
"""
from collections import Counter
from concurrent.futures import ThreadPoolExecutor
import json
import os
import subprocess
import sys
from urllib.parse import quote

sys.path.insert(0, os.path.join(os.path.dirname(os.path.dirname(os.path.abspath(__file__))), "scripts"))
from common import GREEN, RED, YELLOW, fail, need, paint, run, warn

# Every configuration's derivation, by system and name. Lint and the lib tests
# are left out: neither is a configuration, and lint changes with any edit.
DERIVATIONS = 'c: builtins.mapAttrs (_: s: builtins.mapAttrs (_: d: d.drvPath) (builtins.removeAttrs s [ "lint" "lib-tests" ])) c'

# How many untracked files to name before "and N more".
UNTRACKED_SHOWN = 10


def resolve(rev):
    """The full commit hash of `rev`, or stop when git doesn't know it."""
    found = !(git rev-parse --verify --quiet @(rev + '^{commit}'))
    if found.returncode != 0:
        fail(f"Unknown revision {rev!r}.")
    return found.out.strip()


def is_shallow():
    return !(git rev-parse --is-shallow-repository).out.strip() == 'true'


def warn_untracked():
    """Flakes only see tracked files. That covers more than .nix files: the
    flake also reads configs, patches and lists that sit next to them."""
    untracked = [path for path in !(git ls-files --others --exclude-standard -z).out.split('\0') if path]
    if not untracked:
        return
    warn("The flake can't see untracked files. If your change needs one of these, run `git add` on it first:")
    for path in untracked[:UNTRACKED_SHOWN]:
        print(f"    {path}", file=sys.stderr)
    if len(untracked) > UNTRACKED_SHOWN:
        print(f"    and {len(untracked) - UNTRACKED_SHOWN} more", file=sys.stderr)


def evaluate(flake):
    """`nix eval` of every check's derivation in `flake`. The two sides run at
    the same time, so this uses subprocess, which is safe to call from two
    threads."""
    return subprocess.run(['nix', 'eval', '--json', f'{flake}#checks', '--apply', DERIVATIONS],
                          capture_output=True, text=True)


def show_messages(label, result):
    """What Nix said while it evaluated one side: warnings from the configs
    when it passed, the error when it failed. Nothing is hidden. A warning that
    repeats is shown once, with a count."""
    lines = [line for line in result.stderr.splitlines() if line.strip()]
    if not lines:
        return
    print(f"Messages from {label}:", file=sys.stderr)
    if result.returncode != 0:
        # An error trace reads top to bottom: keep every line where it is.
        print(result.stderr.rstrip(), file=sys.stderr)
        return
    for line, count in Counter(lines).items():
        print(f"  {line}" + (f"  (×{count})" if count > 1 else ""), file=sys.stderr)


def by_check(result):
    """{(system, name): drvPath} from what `evaluate` printed."""
    return {(system, name): drv
            for system, checks in json.loads(result.stdout).items()
            for name, drv in checks.items()}


def stands_for(drv):
    """The derivation an eval-only check stands for, or None for a real one.

    The nixos-<host> and darwin-<host> checks in lib/checks.nix don't build the
    system. They are small wrappers that carry the system's derivation path
    in their `drvPath` variable, so that path is the thing worth comparing."""
    shown = !(nix derivation show @(drv))
    if shown.returncode != 0:
        return None
    shown = json.loads(shown.out)
    # Newer Nix nests the derivations under a "derivations" key.
    for derivation in shown.get('derivations', shown).values():
        if isinstance(derivation, dict):
            return derivation.get('env', {}).get('drvPath')
    return None


def explain(old, new):
    """Show what differs between two derivations."""
    inner = stands_for(old), stands_for(new)
    if all(inner):
        print("  (an eval-only check: comparing the system derivations it stands for)")
        old, new = inner
    ![nix-diff @(old) @(new)]


def same(rev, why):
    rev = rev or 'HEAD'
    commit = resolve(rev)
    short = commit[:8]
    shallow = is_shallow()
    warn_untracked()

    # "HEAD (fb7b439d)", but not "fb7b439d (fb7b439d)".
    label = short if commit.startswith(rev) else f'{rev} ({short})'
    # Nix refuses a shallow clone unless it is told to expect one.
    committed = f'git+file://{quote(os.getcwd())}?rev={commit}' + ('&shallow=1' if shallow else '')

    print(f"Evaluating {label} and the working tree…")
    with ThreadPoolExecutor(max_workers=2) as pool:
        runs = dict(zip([label, 'the working tree'], pool.map(evaluate, [committed, '.'])))

    for side, result in runs.items():
        show_messages(side, result)
    for side, result in runs.items():
        if result.returncode != 0:
            hint = ""
            if shallow and side == label:
                hint = " This clone is shallow, so that commit may be out of reach: run `git fetch --unshallow`."
            fail(f"Could not evaluate {side}.{hint}")

    before, after = (by_check(result) for result in runs.values())

    status = {}
    for key in sorted(before.keys() | after.keys()):
        if key not in after:
            status[key] = 'removed'
        elif key not in before:
            status[key] = 'added'
        else:
            status[key] = 'same' if before[key] == after[key] else 'changed'

    if not status:
        fail("Nothing to compare: neither side has a derivation under the flake's `checks` output.")

    print()
    for (system, name), state in status.items():
        word = paint(state.ljust(8), GREEN if state == 'same' else RED)
        print(f"  {word} {system:<15} {name}")
    print()

    different = [key for key, state in status.items() if state != 'same']
    if not different:
        tick = paint('✓', GREEN)
        print(f"{tick} All {len(status)} derivations are the same as {short}.")
        return

    if why:
        for key in different:
            system, name = key
            if status[key] != 'changed':
                print(f"{name} ({system}) was {status[key]}: there is no pair to compare.\n")
                continue
            print(f"{name} ({system}):")
            explain(before[key], after[key])
            print()

    hint = "" if why else " Run it with --why to see what differs."
    fail(f"{len(different)} of {len(status)} derivations differ from {short}.{hint}")


def print_list():
    """The working tree's derivations as JSON on stdout. Everything else goes
    to stderr, so `bin/check --list > file` gets JSON and nothing more."""
    print("Evaluating the working tree…", file=sys.stderr)
    result = evaluate('.')
    show_messages('the working tree', result)
    if result.returncode != 0:
        fail("Could not evaluate the working tree.")
    print(json.dumps(json.loads(result.stdout), indent=2, sort_keys=True))


def main(args):
    need('nix')
    match args:
        case {'--same': True}:
            same(args['<rev>'], args['--why'])
        case {'--list': True}:
            print_list()
        case {'--eval': True}:
            nix flake check --all-systems --no-build
        case {'--all-systems': True}:
            nix flake check --all-systems
        case _:
            # `nix flake check` alone only looks at this machine's system. So
            # evaluate every system first, then build this one's checks.
            nix flake check --all-systems --no-build
            nix flake check


if __name__ == '__main__':
    run(main, __doc__, __file__)

