#!/usr/bin/env bash
set -euo pipefail

cd "$(dirname "$0")/.."

# The regression tests for the helpers in bin/. They run in throwaway
# repositories and need the dev shell's tools (xonsh, nixfmt, deadnix, statix).
# CI runs them in its first job. Extra arguments go to unittest, like
# `bin/test -k hardware`.
nix develop --command python3 -B -m unittest discover -s tests -v "$@"
