#!/usr/bin/env bash
set -euo pipefail

cd "$(dirname "$0")/.."

# The Python tests in tests/, of the scripts in bin/ and .github/scripts/,
# which run in throwaway repos. They need the dev shell's tools. CI runs them
# in its first job. Extra arguments go to Python's unittest, like
# `bin/test -k hardware`. (The Nix tests in tests/ run in `bin/check --eval`.)
nix --extra-experimental-features 'nix-command flakes' develop --command python3 -B -m unittest discover -s tests -v "$@"
