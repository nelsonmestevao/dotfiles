#!/usr/bin/env bash
set -euo pipefail

cd "$(dirname "$0")/.."

# The tests in tests/: the scripts in bin/ and .github/scripts/, which run in
# throwaway repos, and the docs check. They need the dev shell's tools. CI
# runs them in its first job. Extra arguments go to Python's unittest, like
# `bin/test -k hardware`.
nix --extra-experimental-features 'nix-command flakes' develop --command python3 -B -m unittest discover -s tests -v "$@"
