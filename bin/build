#!/usr/bin/env -S nix --extra-experimental-features nix-command --extra-experimental-features flakes develop --command xonsh --no-rc
"""
Builds the system and home configuration and shows what would change, without
switching to it. It needs no sudo and changes nothing on the machine.

Usage:
  {program} [os | home]
  {program} (-h | --help)
  {program} (-v | --version)

Commands:
  os                Build only the system configuration (NixOS or nix-darwin).
  home              Build only the home-manager configuration.

Options:
  -h --help         Show this screen.
  -v --version      Show version.
"""
import os
import shutil
import subprocess
import sys
import tempfile

sys.path.insert(0, os.path.join(os.path.dirname(os.path.dirname(os.path.abspath(__file__))), "scripts"))
from common import COMMAND_ERRORS, GREEN, error, failed, interrupted, need, paint, run


def build(kind):
    """`nh <kind> build`, which prints the package diff against the running
    generation and, unlike `switch`, never activates. True when it built."""
    # Left alone, `nh os build` drops a `result` link in the repo, which keeps
    # the build from garbage collection. A throwaway folder avoids that.
    tmp = tempfile.mkdtemp(prefix='bin-build-')
    # nom redraws a timer many times a second. Without a terminal to draw on,
    # that only floods logs and agent output.
    nom = [] if sys.stdout.isatty() else ['--no-nom']
    try:
        nh @(kind) build . --out-link @(tmp + '/result') @(nom)
        return True
    except COMMAND_ERRORS as problem:
        # Ctrl-C stops everything; it isn't a build that failed.
        if interrupted(problem):
            raise KeyboardInterrupt from problem
        # The nh command line holds a throwaway path, so say it short.
        if isinstance(problem, subprocess.CalledProcessError):
            error(f"nh {kind} build failed")
        else:
            error(failed(problem))
        return False
    finally:
        shutil.rmtree(tmp)


# Each command, and what nh calls it on this machine.
KINDS = {
    'os': 'darwin' if sys.platform == 'darwin' else 'os',
    'home': 'home',
}


def main(args):
    need('nh')
    chosen = [task for task in KINDS if args[task]] or list(KINDS)

    # Build every one even when one fails, so one run reports every error.
    results = [build(KINDS[task]) for task in chosen]

    if not all(results):
        sys.exit(1)
    print(f"{paint('✓', GREEN)} Built. Nothing was switched.")


if __name__ == '__main__':
    run(main, __doc__, __file__)

# vim: ft=xonsh
