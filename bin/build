#!/usr/bin/env -S nix --extra-experimental-features nix-command --extra-experimental-features flakes develop --command xonsh --no-rc
"""
Builds this machine's configs and shows what would change, without switching
to them: its system, when config/hosts.nix gives it one, and your home. It
needs no sudo and changes nothing on the machine.

Usage:
  {program} [os | home]
  {program} (-h | --help)
  {program} (-v | --version)

Commands:
  os                Build only the system (NixOS or nix-darwin).
  home              Build only your home.

Options:
  -h --help         Show this screen.
  -v --version      Show version.
"""
import os
import subprocess
import sys
import tempfile

sys.path.insert(0, os.path.join(os.path.dirname(os.path.dirname(os.path.abspath(__file__))), "scripts"))
from common import GREEN, error, paint, run, targets


def build(kind, pick):
    """`nh <kind> build`, which prints the package diff against the running
    generation and, unlike `switch`, never activates. True when it built."""
    # nom redraws a timer many times a second. Without a terminal to draw on,
    # that only floods logs and agent output.
    nom = [] if sys.stdout.isatty() else ['--no-nom']
    # Left alone, `nh os build` drops a `result` link in the repo, which keeps
    # the build from garbage collection. A throwaway folder avoids that.
    with tempfile.TemporaryDirectory(prefix='bin-build-') as tmp:
        try:
            nh @(kind) build . @(pick) --out-link @(tmp + '/result') @(nom)
            return True
        except subprocess.CalledProcessError:
            # The nh command line holds a throwaway path, so say it short.
            # Ctrl-C isn't caught here, so it stops every build.
            error(f"nh {kind} build failed")
            return False


def main(args):
    chosen = targets('os' if args['os'] else 'home' if args['home'] else None)
    print(f"Building {' and '.join(name for name, _, _ in chosen)}")

    # Build every one even when one fails, so one run reports every error.
    results = [build(kind, pick) for _, kind, pick in chosen]

    if not all(results):
        sys.exit(1)
    print(f"{paint('✓', GREEN)} Built. Nothing was switched.")


if __name__ == '__main__':
    run(main, __doc__, __file__)

# vim: ft=xonsh
