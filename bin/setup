#!/usr/bin/env -S nix --extra-experimental-features nix-command --extra-experimental-features flakes develop --command xonsh
"""
Scaffolds a new host or user and registers it in config/.

Usage:
  {program} host <hostname> [--platform=<platform>] [--system=<system>]
                            [--users=<users>] [--roles=<roles>] [--detect-hardware]
  {program} user <username> [--name=<name>] [--groups=<groups>]
  {program} (-h | --help)
  {program} (-v | --version)

Commands:
  host <hostname>          Create a new host (NixOS, Darwin, or home-only).
  user <username>          Create a new home-manager user.

Options:
  -h --help                Show this screen.
  -v --version             Show version.
  --platform=<platform>    nixos, darwin, or home (Home Manager only).
  --system=<system>        x86_64-linux, aarch64-linux, aarch64-darwin, or
                           x86_64-darwin.
  --users=<users>          The host's users, comma-separated.
  --roles=<roles>          The host's roles, comma-separated, like desktop.
                           Pass an empty value for none.
  --detect-hardware        Read this machine's hardware (NixOS only).
  --name=<name>            The user's full name.
  --groups=<groups>        The user's extra groups, comma-separated.

In a terminal, it asks for each value you leave out. Without one (an agent, a
pipe), it uses the default where there is one and stops where there isn't.
Hardware defaults to a stub. Pass --detect-hardware only when running on the
new NixOS machine. Supply filesystems and a boot loader before evaluating it.
"""
import os
import re
import sys

from docopt import docopt

sys.path.insert(0, os.path.join(os.path.dirname(os.path.dirname(os.path.abspath(__file__))), "scripts"))
from scaffold import apply_files, checked, insert_entry, read_config, require, validate_name

os.chdir(os.path.dirname(os.path.dirname(os.path.abspath(__file__))))


$RED="\033[1;31m"
$YELLOW="\033[1;33m"
$GREEN="\033[1;32m"
$BLUE="\033[1;34m"
$RESET="\033[0m"

RED="\033[1;31m"
YELLOW="\033[1;33m"
GREEN="\033[1;32m"
BLUE="\033[1;34m"
RESET="\033[0m"

HOSTS_FILE = "config/hosts.nix"
USERS_FILE = "config/users.nix"

PLATFORMS = ["nixos", "darwin", "home"]
SYSTEMS = ["x86_64-linux", "aarch64-linux", "aarch64-darwin", "x86_64-darwin"]
DEFAULT_GROUPS = ["docker", "wheel", "networkmanager"]

# ── Templates ────────────────────────────────────────────────────────────

HOST_NIXOS_TEMPLATE = """\
{
  ...
}:
{
  # ── System ───────────────────────────────────────────────────────────
  dotfiles.modules.boot.enable = true;
  dotfiles.modules.locale.enable = true;

  # ── Networking ───────────────────────────────────────────────────────
  dotfiles.modules.networking.enable = true;

  # Enable more modules as needed (see system/modules/nixos/):
  # dotfiles.modules.audio.enable = true;
  # dotfiles.modules.docker.enable = true;
  # dotfiles.modules.gnome.enable = true;
  # dotfiles.modules.printing.enable = true;
  # dotfiles.modules.tailscale.enable = true;
}
"""

HOST_DARWIN_TEMPLATE = """\
{
  ...
}:
{
  # ── Packages & Homebrew ──────────────────────────────────────────────
  dotfiles.modules.homebrew.enable = true;
}
"""

HARDWARE_STUB_TEMPLATE = """\
# TODO: Replace with the real hardware config. On the target NixOS machine run:
#   nixos-generate-config --show-hardware-config > system/hosts/__NAME__/hardware.nix
{
  modulesPath,
  ...
}:
{
  imports = [ (modulesPath + "/installer/scan/not-detected.nix") ];

  # boot.initrd.availableKernelModules = [ ];
  # boot.kernelModules = [ ];
  # fileSystems."/" = { device = "/dev/disk/by-uuid/..."; fsType = "ext4"; };
  # fileSystems."/boot" = { device = "/dev/disk/by-uuid/..."; fsType = "vfat"; };
  # swapDevices = [ ];
}
"""

USER_TEMPLATE = """\
{
  ...
}:
{
  # Shells
  dotfiles.programs.zsh.enable = true;

  # Editors & IDEs
  dotfiles.programs.nvim.enable = true;

  # Dev Tools
  dotfiles.programs.git.enable = true;

  # Enable more programs as needed (see home/programs/):
  # dotfiles.programs.docker.enable = true;
  # Add enableFor to the arguments before using role selectors:
  # dotfiles.programs.vscode.enable = enableFor [ "desktop" ];
}
"""

# ── Helpers ──────────────────────────────────────────────────────────────

def render_template(template, name):
    return template.replace("__NAME_CAP__", name.capitalize()).replace("__NAME__", name)


def has_terminal():
    """gum prompts need a terminal. Agents and pipes don't have one."""
    return sys.stdin.isatty()


def split_list(value):
    """"a, b,c" -> ["a", "b", "c"]. An empty value is an empty list; no value
    (the flag left out) stays None, so resolve() asks or uses the default."""
    if value is None:
        return None
    return [v.strip() for v in value.split(",") if v.strip()]


def choose_many(header, options):
    """Any number of `options`, picked with gum."""
    return [o for o in $(gum choose --no-limit --header @(header) @(options)).strip().split("\n") if o]


def resolve(flag, value, prompt, default=None):
    """A flag's value: what was passed, else the answer to `prompt` in a
    terminal, else `default`. With neither a terminal nor a default, stop."""
    if value is not None:
        return value
    if has_terminal():
        return prompt()
    if default is not None:
        return default
    print(f"{RED}✗{RESET} There's no terminal to ask in. Pass {flag}.")
    sys.exit(1)


def check_choices(flag, values, allowed):
    unknown = [v for v in values if v not in allowed]
    if unknown:
        print(f"{RED}✗{RESET} {flag}: unknown {', '.join(unknown)} (known: {', '.join(allowed)})")
        sys.exit(1)


def nixpkgs_release():
    """The release flake.nix follows, like "26.05". A host installed now records it as stateVersion."""
    with open("flake.nix") as f:
        match = re.search(r'nixpkgs/nixos-(\d+\.\d+)', f.read())
    return require(match and match.group(1), "Could not find the nixpkgs release in flake.nix")


def darwin_max_state_version():
    """nix-darwin's current system.maxStateVersion, read from the locked input. A Mac installed now records it as darwinStateVersion."""
    source = checked(['nix', '--extra-experimental-features', 'nix-command flakes', 'eval', '--raw', '--impure', '--expr', '(builtins.getFlake (toString ./.)).inputs.nix-darwin.outPath'])
    with open(f"{source}/modules/system/version.nix") as f:
        match = re.search(r'maxStateVersion = mkOption \{.*?default = (\d+);', f.read(), re.DOTALL)
    return require(match and match.group(1), "Could not find system.maxStateVersion in nix-darwin")

# ── Commands ───────────────────────────────────────────────────────────────

def setup_host(hostname, args):
    validate_name(hostname, 'host')
    with open(HOSTS_FILE) as source:
        original = source.read()
    hosts = read_config(HOSTS_FILE)
    users = read_config(USERS_FILE)
    require(hostname not in hosts, f"Host '{hostname}' already exists.")
    require(not os.path.lexists(f'system/hosts/{hostname}.nix')
            and not os.path.lexists(f'system/hosts/{hostname}'),
            f"Host files for '{hostname}' already exist.")
    require(users, 'No registered users found. Run bin/setup user <name> first.')

    host_type = resolve("--platform", args['--platform'],
        lambda: $(gum choose --header "Host type:" @(PLATFORMS)).strip())
    host_type = require(host_type, "No host type selected.")
    check_choices("--platform", [host_type], PLATFORMS)

    default_arch = "aarch64-darwin" if host_type == "darwin" else "x86_64-linux"
    arch = resolve("--system", args['--system'],
        lambda: $(gum choose --header "System architecture:" --selected @(default_arch) @(SYSTEMS)).strip(),
        default=default_arch)
    arch = require(arch, "No architecture selected.")
    check_choices("--system", [arch], SYSTEMS)
    require(host_type == 'home' or arch.endswith('-' + ('linux' if host_type == 'nixos' else 'darwin')),
            f'--platform={host_type} is incompatible with --system={arch}.')
    require(not args['--detect-hardware'] or host_type == 'nixos',
            '--detect-hardware is only valid with --platform=nixos.')

    selected = resolve("--users", split_list(args['--users']),
        lambda: choose_many("Users for this host:", sorted(users)))
    require(selected, "No users selected.")
    check_choices("--users", selected, users)
    require(len(selected) == len(set(selected)), '--users contains duplicates.')
    for username in selected:
        validate_name(username, 'user')
        require(os.path.isfile(f'home/users/{username}.nix'),
                f'Registered user {username!r} is missing home/users/{username}.nix.')

    # Optional: a host with no roles only gets what users enable everywhere.
    known = sorted({'desktop', 'server', 'linux', 'darwin'} |
                   {role for host in hosts.values() for role in host.get('roles', [])})
    roles = resolve("--roles", split_list(args['--roles']),
        lambda: choose_many("Roles for this host (none is fine):", known),
        default=[])
    require(len(roles) == len(set(roles)), '--roles contains duplicates.')
    for role in roles:
        validate_name(role, 'role')
        require(role not in hosts and role != hostname, f'Role {role!r} clashes with a host name.')
    require(hostname not in set(known) | set(roles), f'Host {hostname!r} clashes with a role.')
    # A new role is fine, but a typo like "desktp" would quietly leave out
    # every program that user files enable for "desktop", so say so.
    new_roles = [r for r in roles if r not in known]
    if new_roles:
        print(f"{YELLOW}! New role {', '.join(new_roles)}: no host has it yet (known: {', '.join(known)}). Check the spelling.{RESET}")

    entry = {'system': arch, 'users': selected, 'stateVersion': nixpkgs_release()}
    if host_type in ('nixos', 'darwin'):
        entry['platform'] = host_type
    if roles:
        entry['roles'] = roles
    if host_type == 'darwin':
        entry['darwinStateVersion'] = int(darwin_max_state_version())

    files = {}
    if host_type == 'nixos':
        hw_path = f'system/hosts/{hostname}/hardware.nix'
        hardware = render_template(HARDWARE_STUB_TEMPLATE, hostname)
        if args['--detect-hardware']:
            hardware = checked(['nixos-generate-config', '--show-hardware-config'])
            require(hardware, 'Hardware detection returned no configuration.')
        files[hw_path] = hardware
        files[f'system/hosts/{hostname}.nix'] = HOST_NIXOS_TEMPLATE
    elif host_type == 'darwin':
        files[f'system/hosts/{hostname}.nix'] = HOST_DARWIN_TEMPLATE

    files[HOSTS_FILE] = insert_entry(original, hostname, entry)
    apply_files(files, {HOSTS_FILE: original}, {HOSTS_FILE: hosts | {hostname: entry}})

    print(f"{GREEN}✓{RESET} Host '{hostname}' created; new files staged, config edit left unstaged.")
    if host_type == 'nixos':
        if not args['--detect-hardware']:
            print(f"{YELLOW}! Incomplete hardware stub: {hw_path}{RESET}")
            print(f"  On the target machine: nixos-generate-config --show-hardware-config > {hw_path}")
        print(f'  Verify root and boot filesystems in {hw_path}.')
        print(f'  Set a boot loader in system/hosts/{hostname}.nix before evaluation or rebuilding.')
    print('  Review the changes, then run bin/lint and bin/check --eval.')
    print('  To sign commits on this host, set dotfiles.programs.git.signingKey in')
    print('  the user file (home/users/<username>.nix).')
    if host_type != 'home':
        output = 'nixosConfigurations' if host_type == 'nixos' else 'darwinConfigurations'
        print(f'  System config: {output}.{hostname}')
    for username in selected:
        print(f'  Home config: homeConfigurations."{username}@{hostname}"')


def setup_user(username, args):
    validate_name(username, 'user')
    with open(USERS_FILE) as source:
        original = source.read()
    users = read_config(USERS_FILE)
    require(username not in users and not os.path.lexists(f'home/users/{username}.nix'),
            f"User '{username}' already exists.")

    name = resolve("--name", args['--name'],
        lambda: $(gum input --header "Full name:" --placeholder "Nelson Estevão").strip(),
        default=username)
    if not name:
        name = username

    groups = resolve("--groups", split_list(args['--groups']),
        lambda: $(gum input --header "Extra groups (space-separated):" --value @(" ".join(DEFAULT_GROUPS))).strip().split(),
        default=DEFAULT_GROUPS)

    require(len(groups) == len(set(groups)), '--groups contains duplicates.')
    for group in groups:
        validate_name(group, 'group')
    entry = {'name': name, 'extraGroups': groups}
    files = {
        f'home/users/{username}.nix': USER_TEMPLATE,
        USERS_FILE: insert_entry(original, username, entry),
    }
    apply_files(files, {USERS_FILE: original}, {USERS_FILE: users | {username: entry}})
    print(f"{GREEN}✓{RESET} User '{username}' created; new file staged, config edit left unstaged.")
    print(f'  Put your git identity in home/programs/git/profiles/{username}.ini.')
    print(f"  Add the user to an existing host's users list in {HOSTS_FILE},")
    print(f'  or create a host with bin/setup host <hostname> --users={username}.')


def main(args):
    if args['host']:
        setup_host(args['<hostname>'], args)
    elif args['user']:
        setup_user(args['<username>'], args)


if __name__ == '__main__':
    arguments = docopt(__doc__.format(program=__file__), version=f'{os.path.basename(__file__)} script version 1.0')
    try:
        main(arguments)
    except (ValueError, OSError) as error:
        print(f"{RED}✗{RESET} {error}", file=sys.stderr)
        sys.exit(1)

# vim: ft=xonsh
