#!/usr/bin/env -S nix --extra-experimental-features "nix-command flakes" develop --command xonsh
"""
Scaffolds a new host or user and registers it in config/.

Usage:
  {program} host <hostname> [--platform=<platform>] [--system=<system>]
                            [--users=<users>] [--roles=<roles>]
  {program} user <username> [--name=<name>] [--groups=<groups>]
  {program} (-h | --help)
  {program} (-v | --version)

Commands:
  host <hostname>          Create a new host (NixOS, Darwin, or home-only).
  user <username>          Create a new home-manager user.

Options:
  -h --help                Show this screen.
  -v --version             Show version.
  --platform=<platform>    nixos, darwin, or home (Home Manager only).
  --system=<system>        x86_64-linux, aarch64-linux, aarch64-darwin, or
                           x86_64-darwin.
  --users=<users>          The host's users, comma-separated.
  --roles=<roles>          The host's roles, comma-separated, like desktop.
                           Pass an empty value for none.
  --name=<name>            The user's full name.
  --groups=<groups>        The user's extra groups, comma-separated.

In a terminal, it asks for each value you leave out. Without one (an agent, a
pipe), it uses the default where there is one and stops where there isn't.
Without a terminal it also writes a stub hardware.nix, since it can't check
that it runs on the new host.
"""
import glob
import os
import re
import shutil
import sys

from docopt import docopt

os.chdir(os.path.dirname(os.path.dirname(os.path.abspath(__file__))))

# Enable flake features for the `nix fmt` call below.
$NIX_CONFIG = 'experimental-features = nix-command flakes'

$RED="\033[1;31m"
$YELLOW="\033[1;33m"
$GREEN="\033[1;32m"
$BLUE="\033[1;34m"
$RESET="\033[0m"

RED="\033[1;31m"
YELLOW="\033[1;33m"
GREEN="\033[1;32m"
BLUE="\033[1;34m"
RESET="\033[0m"

HOSTS_FILE = "config/hosts.nix"
USERS_FILE = "config/users.nix"

PLATFORMS = ["nixos", "darwin", "home"]
SYSTEMS = ["x86_64-linux", "aarch64-linux", "aarch64-darwin", "x86_64-darwin"]
DEFAULT_GROUPS = ["docker", "wheel", "networkmanager"]

# ── Templates ────────────────────────────────────────────────────────────

HOST_NIXOS_TEMPLATE = """\
{
  config,
  lib,
  pkgs,
  ...
}:
{
  # ── System ───────────────────────────────────────────────────────────
  dotfiles.modules.boot.enable = true;
  dotfiles.modules.locale.enable = true;

  # ── Networking ───────────────────────────────────────────────────────
  dotfiles.modules.networking.enable = true;

  # Enable more modules as needed (see system/modules/nixos/):
  # dotfiles.modules.audio.enable = true;
  # dotfiles.modules.docker.enable = true;
  # dotfiles.modules.gnome.enable = true;
  # dotfiles.modules.printing.enable = true;
  # dotfiles.modules.tailscale.enable = true;
}
"""

HOST_DARWIN_TEMPLATE = """\
{
  config,
  lib,
  pkgs,
  ...
}:
{
  # ── Packages & Homebrew ──────────────────────────────────────────────
  dotfiles.modules.homebrew.enable = true;
}
"""

HARDWARE_STUB_TEMPLATE = """\
# TODO: Replace with the real hardware config. On the target NixOS machine run:
#   nixos-generate-config --show-hardware-config > system/hosts/__NAME__/hardware.nix
{
  config,
  lib,
  pkgs,
  modulesPath,
  ...
}:
{
  imports = [ (modulesPath + "/installer/scan/not-detected.nix") ];

  # boot.initrd.availableKernelModules = [ ];
  # boot.kernelModules = [ ];
  # fileSystems."/" = { device = "/dev/disk/by-uuid/..."; fsType = "ext4"; };
  # fileSystems."/boot" = { device = "/dev/disk/by-uuid/..."; fsType = "vfat"; };
  # swapDevices = [ ];
}
"""

USER_TEMPLATE = """\
{
  enableFor,
  disableFor,
  ...
}:
{
  # Shells
  dotfiles.programs.zsh.enable = true;

  # Editors & IDEs
  dotfiles.programs.nvim.enable = true;

  # Dev Tools
  dotfiles.programs.git.enable = true;

  # Enable more programs as needed (see home/programs/):
  # dotfiles.programs.docker.enable = true;
  # dotfiles.programs.vscode.enable = enableFor [ "desktop" ];

  dotfiles.packages.enable = true;
}
"""

# config/users.nix entry. __KEY__/__NAME__/__GROUPS__ are substituted.
USER_BLOCK_TEMPLATE = """\
  __KEY__ = {
    name = "__NAME__";
    extraGroups = [
__GROUPS__
    ];
  };"""


# ── Helpers ──────────────────────────────────────────────────────────────

def render_template(template, name):
    return template.replace("__NAME_CAP__", name.capitalize()).replace("__NAME__", name)


def require(value, message):
    if not value:
        print(f"{RED}✗{RESET} {message}")
        sys.exit(1)
    return value


def has_terminal():
    """gum prompts need a terminal. Agents and pipes don't have one."""
    return sys.stdin.isatty()


def split_list(value):
    """"a, b,c" -> ["a", "b", "c"]. An empty value is an empty list."""
    return [v.strip() for v in value.split(",") if v.strip()]


def resolve(flag, value, prompt, default=None):
    """A flag's value: what was passed, else the answer to `prompt` in a
    terminal, else `default`. With neither a terminal nor a default, stop."""
    if value is not None:
        return value
    if has_terminal():
        return prompt()
    if default is not None:
        return default
    print(f"{RED}✗{RESET} There's no terminal to ask in. Pass {flag}.")
    sys.exit(1)


def check_choices(flag, values, allowed):
    unknown = [v for v in values if v not in allowed]
    if unknown:
        print(f"{RED}✗{RESET} {flag}: unknown {', '.join(unknown)} (known: {', '.join(allowed)})")
        sys.exit(1)


def quote_key(name):
    """Quote a Nix attribute key unless it is a plain identifier."""
    if re.fullmatch(r'[A-Za-z_][A-Za-z0-9_]*', name):
        return name
    return '"' + name + '"'


def config_has_key(path, name):
    """Whether `path` already has a top-level `<name> = ...` entry (nixfmt indents those by two spaces)."""
    with open(path) as f:
        content = f.read()
    pattern = r'(?m)^  (' + re.escape(name) + r'|"' + re.escape(name) + r'") ='
    return re.search(pattern, content) is not None


def insert_into_config(path, block):
    """Insert a rendered block as the first entry of the attrset in `path`.

    The entries live in the file's last top-level `{` line, so this also works
    for a file that is a function, whose first `{` opens the argument set.
    """
    with open(path) as f:
        lines = f.readlines()
    opens = [i for i, line in enumerate(lines) if line.rstrip("\n") == "{"]
    if not opens:
        print(f"{RED}✗{RESET} Could not find the top-level attrset in {path}")
        sys.exit(1)
    lines.insert(opens[-1] + 1, block + "\n")
    with open(path, "w") as f:
        f.writelines(lines)


def existing_users():
    return sorted(os.path.basename(p)[:-len(".nix")] for p in glob.glob("home/users/*.nix"))


def nixpkgs_release():
    """The release flake.nix follows, like "26.05". A host installed now records it as stateVersion."""
    with open("flake.nix") as f:
        match = re.search(r'nixpkgs/nixos-(\d+\.\d+)', f.read())
    return require(match and match.group(1), "Could not find the nixpkgs release in flake.nix")


def darwin_max_state_version():
    """nix-darwin's current system.maxStateVersion, read from the locked input. A Mac installed now records it as darwinStateVersion."""
    source = $(nix eval --raw --impure --expr '(builtins.getFlake (toString ./.)).inputs.nix-darwin.outPath').strip()
    with open(f"{source}/modules/system/version.nix") as f:
        match = re.search(r'maxStateVersion = mkOption \{.*?default = (\d+);', f.read(), re.DOTALL)
    return require(match and match.group(1), "Could not find system.maxStateVersion in nix-darwin")


def known_roles():
    """Roles any host in config/hosts.nix declares, plus the usual two."""
    with open(HOSTS_FILE) as f:
        content = f.read()
    roles = {"desktop", "server"}
    for block in re.findall(r'roles = \[(.*?)\]', content, re.DOTALL):
        roles.update(re.findall(r'"([^"]+)"', block))
    return sorted(roles)


def finalize(created):
    """Track new files, format, and re-stage so the flake sees them."""
    # Flakes only see git-tracked files; add before any eval/format.
    git add @(created)
    print(f"{BLUE}→{RESET} Formatting...")
    nix fmt .
    git add @(created)


# ── Commands ───────────────────────────────────────────────────────────────

def setup_host(hostname, args):
    if os.path.exists(f"system/hosts/{hostname}.nix") or os.path.isdir(f"system/hosts/{hostname}") or config_has_key(HOSTS_FILE, hostname):
        print(f"{RED}✗{RESET} Host '{hostname}' already exists")
        sys.exit(1)

    users = existing_users()
    if not users:
        print(f"{RED}✗{RESET} No users found in home/users/. Run `bin/setup user <name>` first.")
        sys.exit(1)

    host_type = resolve("--platform", args['--platform'],
        lambda: $(gum choose --header "Host type:" @(PLATFORMS)).strip())
    host_type = require(host_type, "No host type selected.")
    check_choices("--platform", [host_type], PLATFORMS)

    default_arch = "aarch64-darwin" if host_type == "darwin" else "x86_64-linux"
    arch = resolve("--system", args['--system'],
        lambda: $(gum choose --header "System architecture:" --selected @(default_arch) @(SYSTEMS)).strip(),
        default=default_arch)
    arch = require(arch, "No architecture selected.")
    check_choices("--system", [arch], SYSTEMS)

    selected = resolve("--users", args['--users'] and split_list(args['--users']),
        lambda: [u for u in $(gum choose --no-limit --header "Users for this host:" @(users)).strip().split("\n") if u])
    require(selected, "No users selected.")
    check_choices("--users", selected, users)

    # Optional: a host with no roles only gets what users enable everywhere.
    roles = resolve("--roles", None if args['--roles'] is None else split_list(args['--roles']),
        lambda: [r for r in $(gum choose --no-limit --header "Roles for this host (none is fine):" @(known_roles())).strip().split("\n") if r],
        default=[])

    created = []

    # ── Hardware (NixOS only) ──────────────────────────────────────────
    # Detecting reads the machine this runs on. A person runs setup on the new
    # host itself; an agent most likely runs it somewhere else, so without a
    # terminal it writes the stub.
    if host_type == "nixos":
        os.makedirs(f"system/hosts/{hostname}", exist_ok=True)
        hw_path = f"system/hosts/{hostname}/hardware.nix"
        if has_terminal() and shutil.which("nixos-generate-config"):
            print(f"{BLUE}→{RESET} Detecting hardware with nixos-generate-config...")
            hw = $(nixos-generate-config --show-hardware-config)
        else:
            hw = ""
        if hw.strip():
            with open(hw_path, "w") as f:
                f.write(hw)
            print(f"{GREEN}✓{RESET} Generated {hw_path}")
        else:
            with open(hw_path, "w") as f:
                f.write(render_template(HARDWARE_STUB_TEMPLATE, hostname))
            reason = "Could not detect hardware" if has_terminal() else "No terminal, so no hardware detection"
            print(f"{YELLOW}✗ {reason}; wrote a stub to {hw_path} — replace it on the target machine{RESET}")
        created.append(hw_path)

    # ── Host module file ───────────────────────────────────────────────
    if host_type == "nixos":
        host_path = f"system/hosts/{hostname}.nix"
        with open(host_path, "w") as f:
            f.write(render_template(HOST_NIXOS_TEMPLATE, hostname))
        print(f"{GREEN}✓{RESET} Created {host_path}")
        created.append(host_path)
    elif host_type == "darwin":
        host_path = f"system/hosts/{hostname}.nix"
        with open(host_path, "w") as f:
            f.write(render_template(HOST_DARWIN_TEMPLATE, hostname))
        print(f"{GREEN}✓{RESET} Created {host_path}")
        created.append(host_path)

    # ── Register in config/hosts.nix ───────────────────────────────────
    block_lines = [
        "  " + quote_key(hostname) + " = {",
        '    system = "' + arch + '";',
    ]
    if host_type in ("nixos", "darwin"):
        block_lines.append('    platform = "' + host_type + '";')
    if roles:
        block_lines.append("    roles = [ " + " ".join('"' + r + '"' for r in roles) + " ];")
    users_str = " ".join('"' + u + '"' for u in selected)
    block_lines.append("    users = [ " + users_str + " ];")
    block_lines.append('    stateVersion = "' + nixpkgs_release() + '";')
    if host_type == "darwin":
        block_lines.append("    darwinStateVersion = " + darwin_max_state_version() + ";")
    block_lines.append("  };")
    insert_into_config(HOSTS_FILE, "\n".join(block_lines))
    print(f"{GREEN}✓{RESET} Registered host in {HOSTS_FILE}")
    created.append(HOSTS_FILE)

    finalize(created)

    print()
    print(f"{GREEN}✓{RESET} Host '{hostname}' created.")
    print(f"  Next steps:")
    print(f"    {GREEN}→{RESET} To sign commits there, add git.signingKey to its entry in {HOSTS_FILE}")
    if host_type == "nixos":
        print(f"    {GREEN}→{RESET} Rebuild the system:  bin/rebuild os")
        print(f"    {GREEN}→{RESET} Config: nixosConfigurations.{hostname}")
    elif host_type == "darwin":
        print(f"    {GREEN}→{RESET} Rebuild the system:  bin/rebuild os")
        print(f"    {GREEN}→{RESET} Config: darwinConfigurations.{hostname}")
    else:
        print(f"    {GREEN}→{RESET} Rebuild home:  bin/rebuild home")
    for u in selected:
        print(f"    {GREEN}→{RESET} Home config: homeConfigurations.\"{u}@{hostname}\"")


def setup_user(username, args):
    if os.path.exists(f"home/users/{username}.nix") or config_has_key(USERS_FILE, username):
        print(f"{RED}✗{RESET} User '{username}' already exists")
        sys.exit(1)

    name = resolve("--name", args['--name'],
        lambda: $(gum input --header "Full name:" --placeholder "Nelson Estevão").strip(),
        default=username)
    if not name:
        name = username

    groups = resolve("--groups", None if args['--groups'] is None else split_list(args['--groups']),
        lambda: $(gum input --header "Extra groups (space-separated):" --value @(" ".join(DEFAULT_GROUPS))).strip().split(),
        default=DEFAULT_GROUPS)

    created = []

    # ── Home-manager user file ─────────────────────────────────────────
    user_path = f"home/users/{username}.nix"
    with open(user_path, "w") as f:
        f.write(render_template(USER_TEMPLATE, username))
    print(f"{GREEN}✓{RESET} Created {user_path}")
    created.append(user_path)

    # ── Register in config/users.nix ───────────────────────────────────
    group_lines = "\n".join('      "' + g + '"' for g in groups)
    block = (USER_BLOCK_TEMPLATE
             .replace("__KEY__", quote_key(username))
             .replace("__NAME__", name)
             .replace("__GROUPS__", group_lines))
    insert_into_config(USERS_FILE, block)
    print(f"{GREEN}✓{RESET} Registered user in {USERS_FILE}")
    created.append(USERS_FILE)

    finalize(created)

    print()
    print(f"{GREEN}✓{RESET} User '{username}' created.")
    print(f"  Next steps:")
    print(f"    {GREEN}→{RESET} Put your git identity (email) in home/programs/git/profiles/{username}.ini")
    print(f"    {GREEN}→{RESET} Add '{username}' to a host's `users` list in {HOSTS_FILE},")
    print(f"      or run `bin/setup host <hostname>` and select them.")


def main(args):
    if args['host']:
        setup_host(args['<hostname>'], args)
    elif args['user']:
        setup_user(args['<username>'], args)


if __name__ == '__main__':
    arguments = docopt(__doc__.format(program=__file__), version=f'{os.path.basename(__file__)} script version 1.0')
    main(arguments)

# vim: ft=xonsh
