#!/usr/bin/env -S nix --extra-experimental-features "nix-command flakes" develop --command xonsh
"""
Scaffolds a new home-manager program, NixOS system module, or GNOME extension.

Usage:
  {program} program <name>
  {program} module <name>
  {program} extension <name>
  {program} (-h | --help)
  {program} (-v | --version)

Commands:
  program <name>      Create a new home-manager program.
  module <name>       Create a new NixOS system module.
  extension <name>    Create a new GNOME Shell extension module.

Options:
  -h --help           Show this screen.
  -v --version        Show version.
"""
import os
import sys

from docopt import docopt

os.chdir(os.path.dirname(os.path.dirname(os.path.abspath(__file__))))

$RED="\033[1;31m"
$YELLOW="\033[1;33m"
$GREEN="\033[1;32m"
$BLUE="\033[1;34m"
$RESET="\033[0m"

RED="\033[1;31m"
YELLOW="\033[1;33m"
GREEN="\033[1;32m"
BLUE="\033[1;34m"
RESET="\033[0m"

PROGRAM_TEMPLATE = """\
{
  pkgs,
  ...
}:
{
  # Only on one OS? Say so, and enabling it elsewhere is a clear error.
  # platforms = [ "linux" ];

  home.packages = with pkgs; [
    __NAME__
  ];

  # Config files are links into this folder (add mkSymlink to the arguments).
  # A file that isn't in the repo fails the build.
  # xdg.configFile."__NAME__/config" = mkSymlink "config";

  # Shell aliases: programs.zsh.envExtra, see bat.nix.
  # GNOME keybindings: dconf.settings, see ghostty.nix.
}
"""

EXTENSION_TEMPLATE = """\
_: {
  # The package is pkgs.gnomeExtensions.__NAME__ unless you set one here
  # (add pkgs to the arguments):
  # package = pkgs.unstable.gnomeExtensions.__NAME__;
  # package = pkgs.callPackage ./package.nix { };

  # dconf.settings."org/gnome/shell/extensions/__NAME__" = {
  #   some-key = [ "<Super>x" ];
  # };
}
"""

MODULE_TEMPLATE = """\
{
  pkgs,
  ...
}:
{
  environment.systemPackages = with pkgs; [
    __NAME__
  ];

  # services.__NAME__.enable = true;
}
"""


def render_template(template, name):
    return template.replace("__NAME__", name)


def create_program(name):
    dir_path = f"home/programs/{name}"
    file_path = f"{dir_path}/{name}.nix"

    if os.path.exists(file_path):
        print(f"{RED}✗{RESET} Program '{name}' already exists at {file_path}")
        sys.exit(1)

    os.makedirs(dir_path, exist_ok=True)

    content = render_template(PROGRAM_TEMPLATE, name)

    with open(file_path, 'w') as f:
        f.write(content)

    print(f"{GREEN}✓{RESET} Created program at {file_path}")
    print(f"  Enable it in home/users/<username>.nix:")
    print(f"    dotfiles.programs.{name}.enable = true;")


def create_extension(name):
    dir_path = f"home/programs/gnome/extensions/{name}"
    file_path = f"{dir_path}/{name}.nix"

    if os.path.exists(file_path):
        print(f"{RED}✗{RESET} Extension '{name}' already exists at {file_path}")
        sys.exit(1)

    os.makedirs(dir_path, exist_ok=True)

    content = render_template(EXTENSION_TEMPLATE, name)

    with open(file_path, 'w') as f:
        f.write(content)

    print(f"{GREEN}✓{RESET} Created GNOME extension at {file_path}")
    print(f"  Enable it in home/users/<username>.nix:")
    print(f"    dotfiles.programs.gnome.extensions.{name}.enable = true;")


def create_module(name):
    dir_path = f"system/modules/nixos/{name}"
    file_path = f"{dir_path}/{name}.nix"

    if os.path.exists(file_path):
        print(f"{RED}✗{RESET} Module '{name}' already exists at {file_path}")
        sys.exit(1)

    os.makedirs(dir_path, exist_ok=True)

    content = render_template(MODULE_TEMPLATE, name)

    with open(file_path, 'w') as f:
        f.write(content)

    print(f"{GREEN}✓{RESET} Created module at {file_path}")
    print(f"  Enable it in system/hosts/<hostname>.nix:")
    print(f"    dotfiles.modules.{name}.enable = true;")


def main(args):
    name = args['<name>']

    if args['program']:
        create_program(name)
    elif args['module']:
        create_module(name)
    elif args['extension']:
        create_extension(name)


if __name__ == '__main__':
    arguments = docopt(__doc__.format(program=__file__), version=f'{os.path.basename(__file__)} script version 1.0')
    main(arguments)

# vim: ft=xonsh
