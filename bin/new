#!/usr/bin/env -S nix --extra-experimental-features nix-command --extra-experimental-features flakes develop --command xonsh
"""
Scaffolds a new home-manager program, system module (NixOS or nix-darwin), or
GNOME extension.

Usage:
  {program} program <name>
  {program} module <name> [--darwin]
  {program} extension <name>
  {program} (-h | --help)
  {program} (-v | --version)

Commands:
  program <name>      Create a new home-manager program.
  module <name>       Create a new system module (NixOS unless --darwin).
  extension <name>    Create a new GNOME Shell extension module.

Options:
  -h --help           Show this screen.
  -v --version        Show version.
  --darwin            Create a nix-darwin module instead of a NixOS one.
"""
import os
import sys

from docopt import docopt

sys.path.insert(0, os.path.join(os.path.dirname(os.path.dirname(os.path.abspath(__file__))), "scripts"))
from scaffold import apply_files, validate_name

os.chdir(os.path.dirname(os.path.dirname(os.path.abspath(__file__))))

$RED="\033[1;31m"
$YELLOW="\033[1;33m"
$GREEN="\033[1;32m"
$BLUE="\033[1;34m"
$RESET="\033[0m"

RED="\033[1;31m"
YELLOW="\033[1;33m"
GREEN="\033[1;32m"
BLUE="\033[1;34m"
RESET="\033[0m"

PROGRAM_TEMPLATE = """\
{
  pkgs,
  ...
}:
{
  # Only on one OS? Say so, and enabling it elsewhere is a clear error.
  # platforms = [ "linux" ];

  # A setting that user files can set beside `enable` (add lib and config to
  # the arguments). Read it as config.dotfiles.programs.__NAME__.someSetting.
  # options.someSetting = lib.mkEnableOption "what it turns on";

  home.packages = [ pkgs.__NAME__ ];

  # Config files are links into this folder (add mkSymlink to the arguments).
  # A file that isn't in the repo fails the build.
  # xdg.configFile."__NAME__/config" = mkSymlink "config";

  # Shell aliases: home.shellAliases, see bat.nix.
  # GNOME keybindings: dconf.settings, see ghostty.nix.
}
"""

EXTENSION_TEMPLATE = """\
_: {
  # The package is pkgs.gnomeExtensions.__NAME__ unless you set one here
  # (add pkgs to the arguments):
  # package = pkgs.unstable.gnomeExtensions.__NAME__;
  # package = pkgs.callPackage ./package.nix { };

  # A setting that user files can set beside `enable` (add lib and config to
  # the arguments). Read it as
  # config.dotfiles.programs.gnome.extensions.__NAME__.someSetting.
  # options.someSetting = lib.mkEnableOption "what it turns on";

  # dconf.settings."org/gnome/shell/extensions/__NAME__" = {
  #   some-key = [ "<Super>x" ];
  # };
}
"""

MODULE_TEMPLATE = """\
{
  pkgs,
  ...
}:
{
  # A setting that host files can set beside `enable` (add lib and config to
  # the arguments). Read it as config.dotfiles.modules.__NAME__.someSetting.
  # options.someSetting = lib.mkEnableOption "what it turns on";

  environment.systemPackages = [ pkgs.__NAME__ ];

  # services.__NAME__.enable = true;
}
"""


def render_template(template, name):
    return template.replace("__NAME__", name)


# What each kind makes: its folder, its template, its name in messages, and
# the file and line that turn it on.
KINDS = {
    "program": ("home/programs/{name}", PROGRAM_TEMPLATE, "program",
                "home/users/<username>.nix", "dotfiles.programs.{name}.enable = true;"),
    "extension": ("home/programs/gnome/extensions/{name}", EXTENSION_TEMPLATE, "GNOME extension",
                  "home/users/<username>.nix", "dotfiles.programs.gnome.extensions.{name}.enable = true;"),
    "nixos": ("system/modules/nixos/{name}", MODULE_TEMPLATE, "nixos module",
              "system/hosts/<hostname>.nix", "dotfiles.modules.{name}.enable = true;"),
    "darwin": ("system/modules/darwin/{name}", MODULE_TEMPLATE, "darwin module",
               "system/hosts/<hostname>.nix", "dotfiles.modules.{name}.enable = true;"),
}


def create(kind, name):
    validate_name(name, 'module')
    folder, template, label, where, line = KINDS[kind]
    dir_path = folder.format(name=name)
    file_path = f"{dir_path}/{name}.nix"

    if os.path.exists(file_path):
        print(f"{RED}✗{RESET} '{name}' already exists at {file_path}")
        sys.exit(1)

    apply_files({file_path: render_template(template, name)})

    print(f"{GREEN}✓{RESET} Created and staged {label} at {file_path}")
    print(f"  Enable it in {where}:")
    print(f"    {line.format(name=name)}")


def main(args):
    match args:
        case {'program': True}:
            kind = 'program'
        case {'extension': True}:
            kind = 'extension'
        case {'--darwin': True}:
            kind = 'darwin'
        case _:
            kind = 'nixos'
    create(kind, args['<name>'])


if __name__ == '__main__':
    arguments = docopt(__doc__.format(program=__file__), version=f'{os.path.basename(__file__)} script version 1.0')
    try:
        main(arguments)
    except (ValueError, OSError) as error:
        print(f"{RED}✗{RESET} {error}", file=sys.stderr)
        sys.exit(1)

# vim: ft=xonsh
