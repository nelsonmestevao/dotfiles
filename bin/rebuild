#!/usr/bin/env -S nix --extra-experimental-features nix-command --extra-experimental-features flakes develop --command xonsh --no-rc
"""
Switches this machine to its configs: its system, when config/hosts.nix gives
it one, and your home.

Usage:
  {program} [os | home] [--boot]
  {program} (-h | --help)
  {program} (-v | --version)

Commands:
  os                Switch only the system (NixOS or nix-darwin).
  home              Switch only your home.

Options:
  -h --help         Show this screen.
  -v --version      Show version.
  --boot            Start the new system on the next boot instead of now.
                    Use it for major release upgrades, so services like GDM
                    and NetworkManager don't hang while they restart.
                    NixOS only.
"""
import os
import sys

sys.path.insert(0, os.path.join(os.path.dirname(os.path.dirname(os.path.abspath(__file__))), "scripts"))
from common import COMMAND_ERRORS, fail, failed, need, run, targets


def main(args):
    need('nh')
    chosen = targets('os' if args['os'] else 'home' if args['home'] else None)
    if args['--boot'] and not any(kind == 'os' for _, kind, _ in chosen):
        fail("--boot is for a NixOS system only. A home or a Mac switches now. Run it without --boot.")
    print(f"Switching {' and '.join(name for name, _, _ in chosen)}")

    for done, (name, kind, pick) in enumerate(chosen):
        action = 'boot' if args['--boot'] and kind == 'os' else 'switch'
        try:
            nh @(kind) @(action) . @(pick)
        except (*COMMAND_ERRORS, KeyboardInterrupt) as problem:
            # Say what was left undone, so nobody thinks the rest went through.
            skipped = [later for later, _, _ in chosen[done + 1:]]
            note = f"; {' and '.join(skipped)} not switched" if skipped else ""
            fail(f"{failed(problem)}{note}.")


if __name__ == '__main__':
    run(main, __doc__, __file__)

# vim: ft=xonsh
