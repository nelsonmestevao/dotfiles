#!/usr/bin/env -S nix --extra-experimental-features nix-command --extra-experimental-features flakes develop --command xonsh --no-rc
"""
Rebuilds the system and home configuration.

Usage:
  {program} [os | home] [--boot]
  {program} (-h | --help)
  {program} (-v | --version)

Commands:
  os                Rebuild only the system configuration (NixOS or nix-darwin).
  home              Rebuild only the home-manager configuration.

Options:
  -h --help         Show this screen.
  -v --version      Show version.
  --boot            Activate the system on next boot instead of switching live.
                    Use for major release upgrades to avoid hanging on service
                    restarts (e.g. GDM, NetworkManager). NixOS only; ignored
                    for nix-darwin and home.
"""
import os
import sys

sys.path.insert(0, os.path.join(os.path.dirname(os.path.dirname(os.path.abspath(__file__))), "scripts"))
from common import COMMAND_ERRORS, fail, failed, run, with_flakes

with_flakes()


def switch_system(action):
    if sys.platform == 'darwin':
        # nix-darwin has no `boot`: it always switches now.
        nh darwin switch .
    else:
        nh os @(action) .


def switch_home():
    nh home switch .


def main(args):
    action = 'boot' if args['--boot'] else 'switch'
    # Each step: what it switches, and how.
    steps = {
        'os': ('system', lambda: switch_system(action)),
        'home': ('home', switch_home),
    }
    chosen = [step for step in steps if args[step]] or list(steps)

    for done, step in enumerate(chosen):
        try:
            steps[step][1]()
        except (*COMMAND_ERRORS, KeyboardInterrupt) as problem:
            # Say what was left undone, so nobody thinks the rest went through.
            skipped = [steps[s][0] for s in chosen[done + 1:]]
            note = f"; {' and '.join(skipped)} not switched" if skipped else ""
            fail(f"{failed(problem)}{note}.")


if __name__ == '__main__':
    run(main, __doc__, __file__)

# vim: ft=xonsh
